# Multimodal Vision AI Credentials
# Provide GEMINI_API_KEY, NVIDIA_API_KEY, or OPENAI_API_KEY
GEMINI_API_KEY=your_gemini_api_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Provider selection: "auto", "nvidia", "gemini", or "openai"
LLM_PROVIDER=auto

# Security & CORS configuration
CORS_ORIGINS=http://localhost:3000,https://ai-visual-assistant.vercel.app

# Optional server configuration
PORT=8000
DATABASE_URL=sqlite:///./appliance_troubleshooter.db
